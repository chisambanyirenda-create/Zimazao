# Copy this file to `.env` and fill in the values.
# `node start.mjs` does this for you automatically on first run.

# Your Supabase database connection string (Settings -> Database in Supabase).
DATABASE_URL=

# A long random secret used to sign login sessions.
# start.mjs generates one automatically if left empty.
JWT_SECRET=

# Optional — needed only for the AI Crop/Animal Doctor.
GEMINI_API_KEY=

# Optional — needed only for photo uploads on listings.
CLOUDINARY_URL=

# Optional — needed only for real mobile-money payments.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
